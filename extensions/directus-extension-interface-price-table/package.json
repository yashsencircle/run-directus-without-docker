{
  "name": "directus-extension-interface-price-table",
  "description": "Buy/sell price table interface — calculates sell prices client-side using its own field-configured formula, with no dedicated backend endpoint",
  "version": "2.0.0",
  "type": "module",
  "keywords": [
    "directus",
    "directus-extension",
    "directus-custom-interface"
  ],
  "directus:extension": {
    "type": "interface",
    "path": "dist/index.js",
    "source": "src/index.ts",
    "host": "^11.0.0"
  },
  "scripts": {
    "build": "directus-extension build",
    "dev": "directus-extension build -w --no-minify",
    "link": "directus-extension link",
    "rb": "docker compose down && npm run build && docker compose up -d"
  },
  "devDependencies": {
    "@directus/extensions-sdk": "^10.0.0",
    "@directus/types": "^11.0.6",
    "@types/express": "^4.17.21",
    "typescript": "^5.0.0",
    "vue": "^3.3.0"
  },
  "dependencies": {
    "date-fns": "^4.2.1"
  }
}
